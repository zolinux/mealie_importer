# Copy this file to .env and provide your own private Mealie settings.
MEALIE_URL=https://your-mealie-instance.example
MEALIE_TOKEN=replace-with-your-token
MEALIE_VERIFY_SSL=true

# Optional. Set false only for a Mealie instance with a self-signed certificate.
# Relative paths are resolved from the directory containing this script.
MHTML_FILE=

# Optional comma-separated URLs used by the no-argument batch import.
RECIPE_URLS=
